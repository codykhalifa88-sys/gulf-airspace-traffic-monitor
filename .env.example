# Local dev against moto_server. Leave AWS_ENDPOINT_URL unset to target real AWS.
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

ENV_NAME=dev
S3_BUCKET_NAME=gulf-airspace-traffic-monitor-dev
KINESIS_STREAM_NAME=gulf-airspace-states-dev

DYNAMODB_TRAFFIC_TABLE=gulf_traffic_by_region
DYNAMODB_CONFLICT_EVENTS_TABLE=gulf_conflict_events
DYNAMODB_MANIFEST_TABLE=gulf_pipeline_manifest

# Optional free upgrade from OpenSky's anonymous rate limit (400 req/2.2hr,
# current-state-only) to a registered account (4000 req/22.2hr, 5s
# resolution, up to 1hr history). NOT required -- anonymous access works
# fine for this project. Sign up at https://opensky-network.org, then
# create an API client under your account settings (OAuth2 client
# credentials -- basic auth was retired March 2026).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional, sparse, never on the automated cron -- see docs/data_dictionary.md
AVIATIONSTACK_API_KEY=
TRAVELPAYOUTS_TOKEN=

LOG_DIR=logs
